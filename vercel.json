{
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/rescue-pipeline",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://handicaplab-production-129269713730.asia-southeast2.run.app/api/:path*"
    }
  ]
}
