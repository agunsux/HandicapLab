    "canFiveDollarReplaceOddsPapi": {
      "answer": "NO",
      "rationale": "OddsPAPI provides Pinnacle & SBOBET sharp odds, quarter-handicap ladder, and historical tick timestamps. 5Dollar on the evaluated plan supports only Bet365, paywalls Pinnacle behind $49/mo Ultra, returns empty goal ladders, and has an unworkable 60 req/hr rate limit."
    },
    "canFiveDollarReplaceApiFootball": {
      "answer": "NO",
      "rationale": "API-Football covers all whitelist leagues, live match states, lineups, player injuries, and deep multi-season history. 5Dollar is restricted to 5 leagues, caps history at 3 months (HTTP 403), lacks team lineups/injuries, and has zero xG."
    },
    "canDribbleReplaceOddsPapi": {
      "answer": "NO",
      "rationale": "Dribble360 has zero betting market odds endpoints (HTTP 404 across /odds, /fixtures/odds, /bookmakers, /markets, /closing-odds). It cannot provide odds, lines, or CLV."
    },
    "canDribbleReplaceApiFootball": {
      "answer": "NO",
      "rationale": "Dribble360 is an offline batch data provider refreshed once daily at ~08:19 UTC. It lacks real-time kickoff updates, live in-play feeds, and pre-match lineup announcements. Replacing API-Football with Dribble would cause fatal temporal leakage and blindness to same-day fixture changes."
    },
    "canBothReplaceCurrentStack": {
      "answer": "NO",
      "rationale": "Combining both fails critical production invariants: Pinnacle ground-truth odds are missing, live pre-match lineups/injuries are missing, secondary whitelist leagues are absent from 5Dollar, and rate limits block pre-kickoff line monitoring."
    }
